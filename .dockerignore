# Build context is the repo root. This backend image only needs
# pyproject.toml, poetry.lock, and src/ (see Dockerfile) -- everything else
# below is either irrelevant to the running API, a secrets risk, or just
# bloat that would slow the build/push.

.git
.gitignore

# Frontend -- deployed separately to Firebase Hosting, never belongs in the
# backend image.
web/

# Tests and dev tooling -- not needed at runtime, and test fixtures/mocks
# have no business shipping in a production image.
tests/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Local Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Anything credential-shaped must never end up in an image layer, even if it
# doesn't exist in this repo today -- defensive, not because one of these
# currently has content.
secrets/
*.env
.env*
*-key.json
*-credentials.json

# Docs, infra-as-code, pipeline outputs, scratch data -- none of it is read
# by the FastAPI app at runtime.
docs/
infra/
audit_outputs/
data/
configs/
scripts/

# NOT excluded: README.md. pyproject.toml declares it as the package readme,
# and Poetry's root install (`poetry install --only main`, no --no-root)
# reads it during the image build -- excluding it fails the build with
# "Readme path /app/README.md does not exist." It's a few hundred bytes of
# harmless text, not a secrets risk, so keeping it in the build context is
# the simpler fix over restructuring pyproject.toml's package-mode.
