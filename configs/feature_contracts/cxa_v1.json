{
  "metric": "cxa",
  "version": "v1",
  "status": "design_contract",
  "description": "Design-stage contract for contextual expected assist / chance creation modelling.",
  "grain": "one row per eligible attacking action with a fixed lookahead window for shot creation",
  "definition": {
    "public_name": "contextual expected assist",
    "short_name": "CxA",
    "summary": "CxA estimates the probability and quality of a shot created by an eligible attacking action, using only event-data features available at or before that action.",
    "event_data_only": true,
    "tracking_data_required": false
  },
  "eligibility": {
    "eligible_event_types": [
      "Pass",
      "Carry",
      "Dribble",
      "Ball Receipt",
      "Miscontrol recovery",
      "Pressure evasion"
    ],
    "excluded_event_types": [
      "Shot",
      "Goal Keeper",
      "Foul Committed",
      "Bad Behaviour",
      "Injury Stoppage",
      "Tactical Shift"
    ],
    "window": {
      "same_team_only": true,
      "same_possession_preferred": true,
      "max_actions_to_shot": 5,
      "max_seconds_to_shot": 15
    }
  },
  "identity_columns": [
    "action_id",
    "event_id",
    "sequence_id",
    "match_id",
    "possession",
    "team_id",
    "player_id"
  ],
  "target": {
    "target_column": "created_shot_cxg",
    "target_type": "continuous_probability_value",
    "shot_creation_indicator": "shot_created",
    "definition": "CxG value of the first eligible downstream shot created inside the action window; zero when no eligible shot is created.",
    "source": "CxG output or provider xG fallback explicitly recorded by future modelling PRs",
    "zero_when_no_shot": true
  },
  "target_columns": [
    "shot_created",
    "created_shot_cxg"
  ],
  "required_numeric_features": [
    "start_x",
    "start_y",
    "end_x",
    "end_y",
    "length",
    "angle",
    "minute",
    "second",
    "action_position",
    "sequence_length_so_far",
    "seconds_since_possession_start",
    "x_progression",
    "y_progression",
    "distance_to_goal_before",
    "distance_to_goal_after",
    "angle_to_goal_before",
    "angle_to_goal_after"
  ],
  "required_binary_features": [
    "under_pressure",
    "is_pass",
    "is_carry",
    "is_dribble",
    "is_cross",
    "is_cutback",
    "is_through_ball",
    "is_progressive",
    "enters_final_third",
    "enters_penalty_area",
    "enters_zone14",
    "switches_play"
  ],
  "required_categorical_features": [
    "action_type",
    "play_pattern",
    "body_part",
    "pass_height",
    "start_zone",
    "end_zone",
    "start_third",
    "end_third",
    "score_state"
  ],
  "optional_context_features": [
    "opponent_def_rating_global",
    "opponent_zone_block_rate",
    "nearest_defensive_action_seconds",
    "teammate_receipt_pressure",
    "prior_action_type",
    "prior_action_success",
    "carry_under_pressure",
    "set_piece_phase"
  ],
  "optional_reference_features": [
    "statsbomb_xg",
    "created_shot_id",
    "created_shot_distance",
    "created_shot_angle"
  ],
  "prohibited_leakage_columns": [
    "created_shot_outcome",
    "goal_after_action",
    "goal_outcome_after_shot",
    "shot_outcome",
    "assisted_shot_outcome",
    "post_shot_xg",
    "future_possession_value",
    "future_sequence_length",
    "actions_after_current"
  ],
  "forbidden_training_features": [
    "created_shot_outcome",
    "goal_after_action",
    "goal_outcome_after_shot",
    "shot_outcome",
    "assisted_shot_outcome",
    "post_shot_xg",
    "future_possession_value",
    "future_sequence_length",
    "actions_after_current"
  ],
  "nullable_columns": [
    "player_id",
    "body_part",
    "pass_height",
    "opponent_def_rating_global",
    "opponent_zone_block_rate",
    "created_shot_id",
    "created_shot_distance",
    "created_shot_angle",
    "statsbomb_xg"
  ],
  "split_group_column": "match_id",
  "validation_contract": {
    "required_checks": [
      "row_count",
      "target_non_negative",
      "target_upper_bound",
      "no_forbidden_training_features",
      "grouped_validation_by_match",
      "shot_creation_rate",
      "mean_created_shot_cxg",
      "slice_metrics_by_action_type",
      "slice_metrics_by_zone",
      "calibration_or_reliability_summary"
    ],
    "target_bounds": {
      "created_shot_cxg_min": 0.0,
      "created_shot_cxg_max": 1.0
    },
    "baseline_comparisons": [
      "traditional_assist_indicator",
      "uncontextualized_created_shot_xg",
      "simple_location_progression_baseline"
    ]
  },
  "output_contract": {
    "feature_store_dir": "feature_store/cxa/",
    "modeling_dir": "outputs/modeling/cxa/",
    "expected_future_paths": {
      "features": "feature_store/cxa/action_features.parquet",
      "model": "outputs/modeling/cxa/models/contextual_assist_model.joblib",
      "metadata": "outputs/modeling/cxa/models/contextual_assist_model.json",
      "metrics": "outputs/modeling/cxa/reports/metrics.json",
      "validation_summary": "outputs/modeling/cxa/reports/validation_summary.json",
      "predictions": "outputs/modeling/cxa/predictions/action_predictions.parquet",
      "player_aggregates": "outputs/modeling/cxa/aggregates/player_cxa.parquet",
      "team_aggregates": "outputs/modeling/cxa/aggregates/team_cxa.parquet",
      "model_card": "outputs/modeling/cxa/reports/model_card.md"
    }
  },
  "expected_output_columns": [
    "action_id",
    "match_id",
    "team_id",
    "player_id",
    "shot_created",
    "created_shot_cxg",
    "predicted_cxa",
    "baseline_cxa",
    "cxa_above_baseline",
    "model_version"
  ],
  "notes": [
    "This contract defines CxA design and guardrails only; it does not imply a trained CxA model exists.",
    "All model features must be available at the action timestamp.",
    "Downstream shot quality should come from the generated CxG contract when available, with any fallback documented explicitly.",
    "Validation must group by match_id to avoid match-level leakage."
  ]
}
