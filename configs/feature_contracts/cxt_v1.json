{
  "metric": "cxt",
  "version": "v1",
  "status": "baseline_model",
  "description": "Leakage-safe baseline contract for contextual expected threat modelling.",
  "grain": "one row per eligible ball-progression action",
  "definition": {
    "public_name": "contextual expected threat",
    "short_name": "CxT",
    "summary": "CxT values territorial and threat progression from moving the ball into more dangerous pitch states.",
    "baseline_formula": "threat_value(end_location) - threat_value(start_location)",
    "event_data_only": true,
    "tracking_data_required": false
  },
  "variants": {
    "baseline_cxt": {
      "summary": "Zone or grid threat difference between end and start locations.",
      "implemented_in_this_pr": true
    },
    "cxt_plus": {
      "summary": "Baseline CxT with action success, completion probability, and richer event context.",
      "implemented_in_this_pr": false
    },
    "contextual_cxt": {
      "summary": "CxT adjusted for match, possession, pressure, score-state, and play-pattern context available at action time.",
      "implemented_in_this_pr": false
    },
    "advanced_cxt": {
      "summary": "Future state-value formulation that estimates state value before and after the action.",
      "implemented_in_this_pr": false
    },
    "od_cxt": {
      "summary": "Opponent defensive adjusted CxT that accounts for defensive context and opponent suppression effects.",
      "implemented_in_this_pr": false
    },
    "od_cxt_plus": {
      "summary": "Future opponent-adjusted enhanced CxT variant combining CxT+ and defensive adjustment.",
      "implemented_in_this_pr": false
    }
  },
  "eligibility": {
    "eligible_action_types": [
      "pass",
      "carry",
      "dribble",
      "cross",
      "progressive_pass",
      "progressive_carry"
    ],
    "excluded_action_types": [
      "shot",
      "goalkeeper",
      "foul_committed",
      "bad_behaviour",
      "injury_stoppage"
    ]
  },
  "identity_columns": [
    "action_id",
    "event_id",
    "match_id",
    "possession_id",
    "team_id",
    "team_name",
    "player_id",
    "player_name"
  ],
  "required_location_fields": [
    "start_x",
    "start_y",
    "end_x",
    "end_y"
  ],
  "baseline_value_fields": [
    "start_zone",
    "end_zone",
    "start_threat",
    "end_threat",
    "cxt_value"
  ],
  "future_enhancement_fields": [
    "cxt_plus",
    "state_value_before",
    "state_value_after",
    "advanced_cxt",
    "od_cxt",
    "od_cxt_plus"
  ],
  "optional_context_features": [
    "minute",
    "second",
    "period",
    "play_pattern",
    "under_pressure",
    "action_type",
    "body_part",
    "pass_height",
    "is_progressive",
    "enters_final_third",
    "enters_penalty_area",
    "score_state",
    "opponent_def_rating_global",
    "opponent_zone_block_rate"
  ],
  "prohibited_leakage_columns": [
    "future_shot_xg",
    "future_shot_location",
    "future_goal",
    "future_shot_outcome",
    "next_action_is_shot",
    "actions_until_shot",
    "total_future_possession_length",
    "goal_outcome",
    "shot_outcome"
  ],
  "forbidden_training_features": [
    "future_shot_xg",
    "future_shot_location",
    "future_goal",
    "future_shot_outcome",
    "next_action_is_shot",
    "actions_until_shot",
    "total_future_possession_length",
    "goal_outcome",
    "shot_outcome"
  ],
  "nullable_columns": [
    "event_id",
    "possession_id",
    "team_name",
    "player_id",
    "player_name",
    "opponent_def_rating_global",
    "opponent_zone_block_rate"
  ],
  "split_group_column": "match_id",
  "validation_contract": {
    "required_checks": [
      "row_count",
      "valid_pitch_coordinates",
      "no_forbidden_training_features",
      "non_null_start_end_locations",
      "baseline_value_reconciliation",
      "grouped_validation_by_match",
      "slice_metrics_by_action_type",
      "sequence_or_possession_summary"
    ],
    "coordinate_bounds": {
      "x_min": 0.0,
      "x_max": 120.0,
      "y_min": 0.0,
      "y_max": 80.0
    },
    "leakage_rule": "Future outcomes may estimate zone/state values or evaluate CxT, but they must not be used as action-level input features."
  },
  "output_contract": {
    "feature_store_dir": "feature_store/cxt/",
    "modeling_dir": "outputs/modeling/cxt/",
    "expected_future_paths": {
      "features": "feature_store/cxt/action_features.parquet",
      "threat_grid": "outputs/modeling/cxt/threat_grid.parquet",
      "predictions": "outputs/modeling/cxt/predictions/action_threat.parquet",
      "player_aggregates": "outputs/modeling/cxt/aggregates/player_cxt.parquet",
      "team_aggregates": "outputs/modeling/cxt/aggregates/team_cxt.parquet",
      "sequence_aggregates": "outputs/modeling/cxt/aggregates/sequence_cxt.parquet",
      "metrics": "outputs/modeling/cxt/reports/metrics.json",
      "zone_transition_summary": "outputs/modeling/cxt/reports/zone_transition_summary.csv",
      "top_actions": "outputs/modeling/cxt/reports/top_actions.csv",
      "interpretation_summary": "outputs/modeling/cxt/reports/interpretation_summary.json"
    }
  },
  "expected_output_columns": [
    "action_id",
    "match_id",
    "team_id",
    "player_id",
    "start_zone",
    "end_zone",
    "start_threat",
    "end_threat",
    "cxt_value",
    "model_version"
  ],
  "notes": [
    "This contract covers the leakage-safe baseline CxT path; CxT+, Advanced CxT, and opponent-adjusted variants remain future work.",
    "CxT is territorial/threat progression, not shot quality (CxG) or chance-creation attribution (CxA).",
    "Future outcomes can be used offline to estimate zone/state values or evaluate model quality, but not as row-level action input features.",
    "Baseline CxT uses a deterministic zone/grid threat table and cxt_value = end_threat - start_threat."
  ]
}
