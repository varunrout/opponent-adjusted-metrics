# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# Poetry
# NOTE: poetry.lock is deliberately NOT ignored. This is an application, not a
# library, and the Dockerfile does `COPY pyproject.toml poetry.lock ./` -- with
# the lock file untracked, a fresh clone or CI build cannot build the image.

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables -- never commit any of these. web/.env.production in
# particular holds the real Firebase web config used for production builds;
# web/.gitignore's `.env*.local` pattern does NOT match it, which is how it
# ended up unignored and one careless `git add .` away from being committed.
.env
.env.*
!.env.example

# Node / frontend build output at repo root (created by `firebase deploy`,
# which installs its own toolchain here)
node_modules/
.firebase/

# Downloaded/raw data
/data/

# Generated pipeline outputs
outputs/
*.parquet
*.csv

# Keep JSON configs trackable
!configs/**/*.json

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Temporary files
tmp/
temp/
*.tmp

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
